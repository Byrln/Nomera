{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install --frozen-lockfile && bun run build"
  },
  "deploy": {
    "startCommand": "bun run db:migrate && bun start",
    "healthcheckPath": "/sign-in",
    "healthcheckTimeout": 300
  }
}
